@using PHStatistics.Content
@model StudentPopulation
@{
    List<SchoolAssignment> schools = new List<SchoolAssignment>();
    if (ViewBag.Schools != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }
    List<Course> courses = (List<Course>)ViewBag.Courses;
    List<CourseDepartment> department = (List<CourseDepartment>)ViewBag.CourseDepartment;
    int yearStr = (int)ViewBag.Year;
    int weekStr = (int)ViewBag.Week;
    SchoolYear schoolYear = (SchoolYear)ViewBag.SelectedYear;
}

<section>
    <div class="py-5 bg-lightbg">
        <div class="container mb-3">
            <form action="/StudentPopulation/CreatePopulation" method="post" role="form" id="formPopulation">
                <fieldset class="center"><h1>@yearStr 年第 @weekStr 週百倍速人數表輸入</h1></fieldset>
                @{
                    string statusBadgeClass = Model.Status == StudentPopulationStatus.Documented ? "bg-secondary" : "bg-success";
                    string statusText = Model.Status switch {
                        StudentPopulationStatus.Documented => "建檔中",
                        StudentPopulationStatus.Pending => "已送出",
                        StudentPopulationStatus.Approved => "已審核",
                        StudentPopulationStatus.Rejected => "已否決",
                        StudentPopulationStatus.Finished => "已完成",
                        _ => Model.Status.ToString()
                    };
                }
                <fieldset class="center"><span class="badge @statusBadgeClass fs-6">@statusText</span></fieldset>
                <input type="hidden" name="SchoolId" id="SchoolId" value="@Model.School.Id" />
                <input type="hidden" name="Week" id="Week" value="@Model.Week" />
                <input type="hidden" name="Name" id="Name" value="@Model.Name" />
                <div class="row mx-0" style="background-color:#b2dd6e">
                    <div class="col-2 mb-2">
                        班系
                    </div>
                    <div class="col-3 mb-3">
                        課程名稱
                    </div>
                    <div class="col-1 mb-1">
                        班別
                    </div>
                    <div class="col-2 mb-2">
                        分校班級名稱
                    </div>
                    <div class="col-1 mb-1">
                        本週人數
                    </div>
                    <div class="col-2 mb-2">
                        學生備註
                    </div>
                    <div class="col-1 mb-1">
                    </div>
                </div>
                @if (Model.Status == StudentPopulationStatus.Documented) {
                <div class="mb-3">
                    <button type="button" class="btn btn-success btn-sm btn-round"
                            data-bs-toggle="modal" data-bs-target="#addClassModal">
                        ＋ 新增班級
                    </button>
                </div>

                <div class="modal fade" id="addClassModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">新增班級</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">班系</label>
                                    <select class="form-select" id="new_department">
                                        <option selected disabled>選擇班系</option>
                                        @foreach (CourseDepartment dItem in department.Where(e => e.IsSum == false && e.Published)) {
                                            <option value=@dItem.Id>@dItem.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">課程</label>
                                    <select class="form-select" id="new_courses">
                                        <option value="">請先選擇班系</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">班別</label>
                                    <select class="form-select" id="new_class_type">
                                        <option value="">請先選擇課程</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">班級名稱</label>
                                    <input type="text" class="form-control" id="new_class_name" value="">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">本週人數</label>
                                    <input type="number" class="form-control" id="new_number" value="0" min="0">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">學生備註</label>
                                    <input type="text" class="form-control" id="new_studentremark" value="">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                                <button type="button" class="btn btn-primary" onclick="addNewClassItem()">新增</button>
                            </div>
                        </div>
                    </div>
                </div>
                }
                @{
                    int itemRowNo = 0;
                }
                <div id="contentItem">
                    @await Html.PartialAsync("PopulationPartialView", Model)
                </div>
                @if (Model.Status == StudentPopulationStatus.Documented) {
                    <div class="mt-3 text-center">
                        <div id="submitSummary" class="alert alert-info py-2 mt-3 mb-1" style="display:none;font-size:14px;"></div>
                        <button type="button" class="btn btn-success btn-lg btn-round" onclick="confirmPopulation(@Model.Id)">
                            確認送出 <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</section>


<script>
    let deletedCount = 0;

    function updateSubmitSummary() {
        const newCount  = document.querySelectorAll('#contentItem .row-new').length;
        const zeroNames = [...document.querySelectorAll('#contentItem .row-zero')]
            .map(row => {
                const inp = row.querySelector('.class-name-input');
                return inp ? inp.value.trim() : '';
            })
            .filter(n => n.length > 0);

        const parts = [];
        if (newCount    > 0) parts.push('<span class="text-success fw-bold">本週新增 ' + newCount + ' 班</span>');
        if (deletedCount > 0) parts.push('<span class="text-secondary fw-bold">已刪除 ' + deletedCount + ' 班</span>');
        if (zeroNames.length > 0)
            parts.push('<span class="text-danger fw-bold">人數歸零（下週不帶入）：' + zeroNames.join('、') + '</span>');

        const el = document.getElementById('submitSummary');
        if (!el) return;
        if (parts.length > 0) {
            el.innerHTML = parts.join('&nbsp;&nbsp;');
            el.style.display = 'block';
        } else {
            el.style.display = 'none';
        }
    }

    function addNewClassItem() {
        var schoolId = @Model.School.Id;
        var year = @Model.Year;
        var week = @Model.Week;
        var newCourses = document.getElementById("new_courses");
        var newClassType = document.getElementById("new_class_type");
        var newClassName = document.getElementById("new_class_name");
        var newNumber = document.getElementById("new_number");
        var newStudentremark = document.getElementById("new_studentremark");
        var itemArr = [];
        var classData = document.querySelectorAll('[data-course]');
        console.log('classData', classData);
        if (classData && classData.length > 0){
            for (var i = 0; i < classData.length; i++) {
                var classItem = classData[i];
                var typeSelect = document.getElementById("class_type_" + classItem.dataset.class);
                console.log(typeSelect);
                //console.log(typeSelect.value);
                itemArr.push([classItem.dataset.course, classItem.dataset.class, classItem.value]);
            }
        }     

        $.ajax({
            url: '@Url.Action("AddNewClass", "StudentPopulation")',
            cache: false,
            data: { 'schoolId': schoolId, 'courseId': newCourses.value, 'week': week, 'year': year, 'itemArr': itemArr, 'newClassType': newClassType.value, 'newClassName': newClassName.value, 'newNumber': newNumber.value, 'newStudentremark': newStudentremark.value, 'type': 'PSJ' },
            // dataType: 'application/json',
            type: 'POST',
            dataType: "html",
            success: function (data) {
                $("#contentItem").html(data);
                if (typeof updateSubmitSummary === 'function') updateSubmitSummary();
                document.querySelector('#addClassModal [data-bs-dismiss="modal"]')?.click();
                $('#new_class_name').val('');
                $('#new_number').val(0);
                $('#new_studentremark').val('');
                $('#new_department').prop('selectedIndex', 0);
                $('#new_courses').html('<option value="">請先選擇班系</option>');
                $('#new_class_type').html('<option value="">請先選擇課程</option>');
            },
            error: function () {
                alert("班級新增失敗!!");
                return false;
            }
        });
    }

    function removeClassItem(sId){
        if(confirm('確認要刪除班級資料!?')==true){
            $.ajax({
                url: '@Url.Action("RemoveClassItem", "StudentPopulation")',
                cache: false,
                data: { 'sId': sId },
                // dataType: 'application/json',
                type: 'POST',
                dataType: "html",
                success: function (data) {
                    $("#contentItem").html(data);
                    deletedCount++;
                    updateSubmitSummary();
                },
                error: function () {

                }
            });
        }else{
            return false;
        }

    }

    $("#new_department").on('change', function() {
            console.log("ExamCity");
            const depId = $(this).val();
            if (!depId) return;

            $("#new_courses").html('<option selected disabled value="">選擇課程</option>');

            $.ajax({
                url: `/GetCourses?depId=${depId}`,
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        const courses = response.data;
                        if(courses.length < 1) {
                            $("#new_courses").html('<option selected disabled value="">無對應課程</option>');
                        }
                        courses.forEach(cou => {
                            const displayText = cou.Name;
                            const option = $("<option>")
                                .val(cou.Id)
                                .text(displayText)
                                .data('name', cou.Name);
                            $("#new_courses").append(option);
                        });
                    }
                },
                error: function() {
                    alert('無法取得課程資料，請稍後再試');
                }
            });
     });

    $("#new_courses").on('change', function() {
            console.log("ExamCity");
            const coursesId = $(this).val();
            if (!coursesId) return;
            $("#new_class_type").html('<option selected selected="selected">選擇班別</option>');
            $.ajax({
                url: `/GetClassType?coursesId=${coursesId}`,
                type: 'GET',
                success: function(response) {
                    console.log('response',response);
                    if (response.success) {
                        const courses = response.data;
                        console.log('Dep', courses.Department.Name);
                        if(courses.Department.Name == '數學班') {
                            const option1 = $("<option>")
                                .val(1)
                                .text('EM1')
                                .data('name', 'EM1');
                            $("#new_class_type").append(option1);
                            const option2 = $("<option>")
                                .val(4)
                                .text('小')
                                .data('name', '小');
                            $("#new_class_type").append(option2);

                        }else if(courses.ClassType == 'EM1、團'){
                              const option1 = $("<option>")
                                .val(1)
                                .text('EM1')
                                .data('name', 'EM1');
                            $("#new_class_type").append(option1);
                            const option2 = $("<option>")
                                .val(0)
                                .text('團')
                                .data('name', '團');
                            $("#new_class_type").append(option2);
                        }else{
                             $("#new_class_type").html('<option selected disabled value="">無需設定班別</option>');
                        }
                    }
                },
                error: function() {
                    alert('無法取得課程資料，請稍後再試');
                }
            });
       });

     function valueChange(sId){
            var updateCourses = document.getElementById(sId);
             console.log('updateCourses',updateCourses.dataset);
            console.log('updateCourses',updateCourses.value);
            // console.log('updateCourses',updateCourses.data["sid"]);
            $.ajax({
            url: '@Url.Action("UpdateClassItem", "StudentPopulation", new { area = "" })',
            cache: false,
            data: { 'sId': updateCourses.dataset.sitem, 'number': updateCourses.value },
            // dataType: 'application/json',
            type: 'POST',
            dataType: "html",
            success: function (data) {
                $("#contentItem").html(data);
                if (typeof updateSubmitSummary === 'function') updateSubmitSummary();
            },
            error: function () {

            }
        });
    }

    function confirmPopulation(populationId) {
        if (!confirm('確認要送出人數表？送出後本週資料將無法修改，如需調整須由管理人員解鎖並說明原因。')) return;
        $.ajax({
            url: '@Url.Action("ConfirmPopulation", "StudentPopulation")',
            type: 'POST',
            data: { populationId: populationId },
            success: function (res) {
                if (res.success) {
                    alert('人數表已成功送出！');
                    location.reload();
                } else {
                    alert(res.message || '送出失敗');
                }
            },
            error: function () {
                alert('送出失敗，請稍後再試');
            }
        });
    }

    $(document).ready(function () {
        updateSubmitSummary();
    });

    function updateClassDetail(classId, populationId) {
        const name      = $('#class_' + classId).val();
        const classType = $('#class_type_' + classId).val() || 0;

        $.ajax({
            url: '/StudentPopulation/UpdateClassDetail',
            type: 'POST',
            data: { populationId: populationId, classId: classId, name: name, classType: classType },
            success: function (result) {
                if (!result.success) alert(result.message || '更新失敗');
            },
            error: function () { alert('連線錯誤，請重試'); }
        });
    }

    function remarkChange(sId) {
        var remarkInput = document.getElementById(sId);
        $.ajax({
            url: '@Url.Action("UpdateRemark", "StudentPopulation", new { area = "" })',
            type: 'POST',
            data: { sId: remarkInput.dataset.sitem, studentRemark: remarkInput.value },
            success: function (result) {
                if (result.success) {
                    remarkInput.style.borderColor = '#28a745';
                    setTimeout(function () { remarkInput.style.borderColor = ''; }, 1000);
                } else {
                    remarkInput.style.borderColor = '#dc3545';
                    setTimeout(function () { remarkInput.style.borderColor = ''; }, 2000);
                }
            },
            error: function () {
                remarkInput.style.borderColor = '#dc3545';
                setTimeout(function () { remarkInput.style.borderColor = ''; }, 2000);
            }
        });
    }
</script>
