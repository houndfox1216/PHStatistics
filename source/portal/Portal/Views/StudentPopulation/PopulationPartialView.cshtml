@using PHStatistics.Content
@model StudentPopulation
@{
    List<SchoolAssignment> schools = new List<SchoolAssignment>();
    if (ViewBag.Schools != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }
    List<Course> courses = (List<Course>)ViewBag.Courses;
    StudentPopulation studentPopulation = (StudentPopulation)ViewBag.LastWeekData;
}
@foreach (Course cItem in courses) {
    if (studentPopulation.Items.Any(e => e.Class.Course.Id == cItem.Id)) {
        <div class="row mx-0">
            <div class="col-2 mb-3">
                <label>
                    @cItem.Name
                </label>
            </div>
            <div class="col-2 mb-3">
                <button type="button" class="btn btn-primary btn-sm btn-round" id="add-@cItem.Id" onclick="addClass(@cItem.Id)">
                    +
                </button>
            </div>
        </div>
        <div class="row mx-0">
            <div class="col-2 mb-3">
                班級名稱
            </div>
            <div class="col-2 mb-3">
                類別
            </div>
            <div class="col-2 mb-3">
                上週人數
            </div>
            <div class="col-2 mb-3">
                本週人數
            </div>
            <div class="col-2 mb-3">
                學生備註
            </div>
        </div>
        foreach (StudentPopulationItem sItem in studentPopulation.Items.Where(e => e.Class.Course.Id == cItem.Id)) {
            <div class="row mx-0">
                <div class="col-2 mb-3">
                    <input type="text" class="form-control" placeholder="" id="class_@sItem.Class.Id.ToString()" value="@sItem.Class.Name">
                </div>
                <div class="col-2 mb-3">
                    <input type="text" class="form-control" placeholder="" id="class_@sItem.Class.Id.ToString()" value="@sItem.Class.Name">
                </div>
                <div class="col-2 mb-3">
                    @sItem.Number
                </div>
                <div class="col-2 mb-3">
                    <input type="number" class="form-control" placeholder="" id="class_@sItem.Class.Id.ToString()_count" value="@sItem.Number">
                </div>
                <div class="col-2 mb-3">
                    <input type="text" class="form-control" placeholder="" id="class_@sItem.Class.Id.ToString()_remark" value="@sItem.StudentRemark">
                </div>
            </div>
        }
    }
}