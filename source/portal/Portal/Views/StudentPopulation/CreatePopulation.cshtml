@using PHStatistics.Content
@model StudentPopulation
@{
    List<SchoolAssignment> schools = new List<SchoolAssignment>();
    if (ViewBag.Schools != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }
    List<Course> courses = (List<Course>)ViewBag.Courses;
    // List<CourseDepartment> department = (List<CourseDepartment>)ViewBag.CourseDepartment;
    int yearStr = (int)ViewBag.Year;
    int weekStr = (int)ViewBag.Week;
    SchoolYear schoolYear = (SchoolYear)ViewBag.SelectedYear;
}

<section>
    <div class="py-5 bg-lightbg">
        <div class="container mb-3">
            <form action="/StudentPopulation/CreatePopulation" method="post" role="form" id="formPopulation">
                <fieldset class="center"><h1>@yearStr 年第 @weekStr 週百瀚人數表輸入</h1></fieldset>
                @if (schoolYear != null) {
                    <fieldset class="center"><h1>@schoolYear.WeekStartDate.ToString("yyyy/MM/dd") ~ @schoolYear.WeekEndDate.ToString("yyyy/MM/dd")</h1></fieldset>
                }
                <input type="hidden" name="SchoolId" id="SchoolId" value="@Model.School.Id" />
                <input type="hidden" name="Week" id="Week" value="@Model.Week" />
                <input type="hidden" name="Name" id="Name" value="@Model.Name" />
                <div class="row mx-0" style="background-color:#b2dd6e">
                    <div class="col-2 mb-3">
                        班系
                    </div>
                    <div class="col-2 mb-3">
                        課程名稱
                    </div>
                    <div class="col-2 mb-3">
                        班別
                    </div>
                    <div class="col-2 mb-3">
                        分校班級名稱
                    </div>
                    <div class="col-2 mb-3">
                        本週人數
                    </div>
                    <div class="col-2 mb-3">
                        學生備註
                    </div>
                    <div class="col-2 mb-3">
                    </div>
                </div>
                <div class="row mx-0" style="background-color:#b2dd6e">
                    <div class="col-2 mb-3">
                        <select class="form-select" id="new_department">
                            <option selected disabled>選擇班系</option>
                            @foreach (Course cItem in courses.Where(e => e.IsSum == false)) {
                                <option value=@cItem.Id>@cItem.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-2 mb-3">
                        <select class="form-select" id="new_courses">
                            <option selected disabled>選擇課程</option>
                            @foreach (Course cItem in courses.Where(e => e.IsSum == false)) {
                                <option value=@cItem.Id>@cItem.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-2 mb-3">
                        <select class="form-select validate[required]" id="new_class_type">
                            <option selected selected="selected">選擇班別</option>
@*                             <option value=1>1V1</option>
                            <option value=2>1V2</option> *@
                            <option value=3>三</option>
                            <option value=4>小</option>
                        </select>
                    </div>
                    <div class="col-2 mb-3">
                        <input type="text" class="form-control" placeholder="" id="new_class_name" value="">
                    </div>
                    <div class="col-2 mb-3">
                        <input type="number" class="form-control" placeholder="請輸入人數" name="new_number" id="new_number" value="0">
                    </div>
                    <div class="col-2 mb-3">
                        <input type="text" class="form-control" placeholder="" name="new_studentremark" id="new_studentremark" value="">
                    </div>
                    <div class="col-2 mb-3">
                        <button type="button" class="btn btn-primary btn-sm btn-round" id="add-new" onclick="addNewClassItem()">
                            +
                        </button>
                    </div>
                </div>
                @*                 <div id="formContent">
                @await Html.PartialAsync("PopulationPartialView", Model)
                </div> *@
                @{
                    int itemRowNo = 0;
                }
                <div id="contentItem">
                    @await Html.PartialAsync("PopulationPartialView", Model)
                </div>
                <div>
                    <button type="submit" class="btn w-100 btn-primary btn-lg btn-round">
                        確認 <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>


<script>
    function addNewClassItem() {
        var schoolId = @Model.School.Id;
        var year = @Model.Year;
        var week = @Model.Week;
        var newCourses = document.getElementById("new_courses");
        var newClassType = document.getElementById("new_class_type");
        var newClassName = document.getElementById("new_class_name");
        var newNumber = document.getElementById("new_number");
        var newStudentremark = document.getElementById("new_studentremark");
        var itemArr = [];
        var classData = document.querySelectorAll('[data-course]');
        console.log('classData', classData);
        if (classData && classData.length > 0){
            for (var i = 0; i < classData.length; i++) {
                var classItem = classData[i];
                var typeSelect = document.getElementById("class_type_" + classItem.dataset.class);
                // console.log(typeSelect);
                // console.log(typeSelect.value);
                itemArr.push([classItem.dataset.course, classItem.dataset.class, classItem.value]);
            }
        }
        $.ajax({
            url: '@Url.Action("AddNewClass", "StudentPopulation")',
            cache: false,
            data: { 'schoolId': schoolId, 'courseId': newCourses.value, 'week': week, 'year': year, 'itemArr': itemArr, 'newClassType': newClassType.value, 'newClassName': newClassName.value, 'newNumber': newNumber.value, 'newStudentremark': newStudentremark.value, 'type': 'PH' },
            // dataType: 'application/json',
            type: 'POST',
            dataType: "html",
            success: function (data) {
                alert("班級已新增!!");
                $("#contentItem").html(data);
            },
            error: function () {
                 alert("班級新增失敗!!");
                 return false;
            }
        });
    }

    function removeClassItem(sId){
            $.ajax({
            url: '@Url.Action("RemoveClassItem", "StudentPopulation")',
            cache: false,
            data: { 'sId': sId },
            // dataType: 'application/json',
            type: 'POST',
            dataType: "html",
            success: function (data) {
                $("#contentItem").html(data);
            },
            error: function () {

            }
        });
    }

      $("#new_department").on('change', function() {
            console.log("ExamCity");
            const depId = $(this).val();
            if (!depId) return;

            $("#new_courses").html('<option selected disabled value="">選擇課程</option>');

