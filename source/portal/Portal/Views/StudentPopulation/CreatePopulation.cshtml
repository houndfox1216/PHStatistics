    function addClassItem(cId) {
        var schoolId = @Model.School.Id;
        var year = @Model.Year;
        var week = @Model.Week;
        var testArr = [];
        var classData = document.querySelectorAll('[data-course]');
        for (var i = 0; i < classData.length; i++) {
            var classItem = classData[i];
            var typeSelect = document.getElementById("class_type_" + classItem.dataset.class);
            console.log(typeSelect);
            console.log(typeSelect.value);
            testArr.push([classItem.dataset.course, classItem.dataset.class, classItem.value]);
        }
        // $.post("demo_ajax_gethint.asp", { 'schoolId': schoolId, 'courseId': cId, 'week': week, 'year': year, 'itemArr': testArr }, function (result) {
        //     $("#contentItem").html(result);
        // });
        $.ajax({
            url: '@Url.Action("AddClass", "StudentPopulation")',
            cache: false,
            data: { 'schoolId': schoolId, 'courseId': cId, 'week': week, 'year': year, 'itemArr': testArr },
           // dataType: 'application/json',
            type: 'POST',
            dataType: "html",
            success: function (data) {                
                $("#contentItem").html(data);
            },
            error: function () {

            }
        });
    }
