    function addClassItem(cId) {
        $.ajax({
            url: '@Url.Action("AddClass", "StudentPopulation")',
            cache: false,
            data: { 'data': $("#formPopulation").serialize(), 'courseId': cId },
            dataType: 'application/json',
            type: 'POST',
            success: function (data) {
                alert('OK');
            },
            error: function () {

            }
        });
    }
</script>
