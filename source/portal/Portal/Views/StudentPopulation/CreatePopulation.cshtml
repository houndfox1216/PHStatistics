@using PHStatistics.Content
@model StudentPopulation
@{
    List<SchoolAssignment> schools = new List<SchoolAssignment>();
    if (ViewBag.Schools != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }
    List<Course> courses = (List<Course>)ViewBag.Courses;
    StudentPopulation studentPopulation = (StudentPopulation)ViewBag.LastWeekData;
}

<section>
    <div class="py-5 bg-lightbg">
        <div class="container mb-3">
            <form action="/StudentPopulation/CreatePopulation" method="post" role="form" id="formPopulation">
                <fieldset class="mb-3">人數表輸入</fieldset>
                <input type="hidden" name="SchoolId" id="SchoolId" value="@Model.School.Id" />
                <input type="hidden" name="Week" id="Week" value="@Model.Week" />
                <input type="hidden" name="Name" id="Name" value="@Model.Name" />
                @*                 <div id="formContent">
                @await Html.PartialAsync("PopulationPartialView", Model)
                </div> *@
                @{
                    int itemRowNo = 0;
                }
                @foreach (Course cItem in courses) {
                    if (studentPopulation.Items.Any(e => e.Class.Course.Id == cItem.Id)) {
                        <div class="row mx-0">
                            <div class="col-2 mb-3">
                                <label>
                                    @cItem.Name
                                </label>
                            </div>
                            <div class="col-2 mb-3">
                                <button type="button" class="btn btn-primary btn-sm btn-round" id="add-@cItem.Id" onclick="addClassItem(@cItem.Id)">
                                    +
                                </button>
                            </div>
                        </div>
                        <div class="row mx-0">
                            <div class="col-2 mb-3">
                                班級名稱
                            </div>
                            <div class="col-2 mb-3">
                                類別
                            </div>
                            <div class="col-2 mb-3">
                                上週人數
                            </div>
                            <div class="col-2 mb-3">
                                本週人數
                            </div>
                            <div class="col-2 mb-3">
                                學生備註
                            </div>
                        </div>
                        foreach (StudentPopulationItem sItem in studentPopulation.Items.Where(e => e.Class.Course.Id == cItem.Id)) {
                            <div class="row mx-0">
                                <div class="col-2 mb-3">
                                    <input type="hidden" class="form-control" name="Items[@itemRowNo].ClassId" id="class_@sItem.Class.Id.ToString()" value="@sItem.Class.Id">
                                    <input type="text" class="form-control" name="Items[@itemRowNo].Class.Id" id="class_@sItem.Class.Id.ToString()" value="@sItem.Class.Name">
                                </div>
                                <div class="col-2 mb-3">
                                    <input type="text" class="form-control" placeholder="" id="class_@sItem.Class.Id.ToString()" value="@sItem.Class.Name">
                                </div>
                                <div class="col-2 mb-3">
                                    @sItem.Number
                                </div>
                                <div class="col-2 mb-3">
                                    <input type="number" class="form-control" placeholder="請輸入人數" name="Items[@itemRowNo].Number" id="class_@sItem.Class.Id.ToString()_count" value="@sItem.Number">
                                </div>
                                <div class="col-2 mb-3">
                                    <input type="text" class="form-control" placeholder="" name="Items[@itemRowNo].StudentRemark" id="class_@sItem.Class.Id.ToString()_remark" value="@sItem.StudentRemark">
                                </div>
                            </div>
                            itemRowNo++;
                        }
                    }
                }
                <div class="">
                    <button type="submit" class="btn w-100 btn-primary btn-lg btn-round">
                        確認 <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>


