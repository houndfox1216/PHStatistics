@using PHStatistics.Content
@model StudentPopulation
@{
    List<SchoolAssignment> schools = new List<SchoolAssignment>();
    if (ViewBag.Schools != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }

    if (ViewBag.Weeks != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }
    string addType = ViewBag.Type;
}

<div class="container py-5">
    <div class="row justify-content-center mb-6">
        <div class="col-12 col-sm-10 col-md-8 col-xl-6">
            <div class="mt-3 mb-4">
                @if (schools != null) {
                    <label for="">
                        分校 <small class="text-primary">＊必填</small>
                    </label>
                    <select class="form-select validate[required]" id="schoolSelect">
                        <option selected disabled>選擇分校</option>
                        @foreach (SchoolAssignment assignment in schools) {
                            <option value=@assignment.School.Id>@assignment.School.Name</option>
                        }
                    </select>
                    if (ViewBag.Years != null) {
                        int[] years = (int[])ViewBag.Years;
                        <label for="">
                            年度
                        </label>
                        <select class="form-select " id="queryYear">
                            <option selected disabled>選擇年度</option>
                            <option value=0>全部</option>
                            @foreach (int yearItem in years) {
                                <option value=@yearItem>@yearItem.ToString()</option>
                            }
                        </select>
                    }
                    if (ViewBag.Weeks != null) {
                        int[] weeks = (int[])ViewBag.Weeks;
                        <label for="">
                            週次
                        </label>
                        <select class="form-select " id="queryWeek">
                            <option selected disabled>選擇週次</option>
                            <option value=0>全部</option>
                            @foreach (int weeekItem in weeks) {
                                <option value=@weeekItem>@weeekItem.ToString()</option>
                            }
                        </select>
                    }
                }
            </div>
            <div class="">
                <button type="button" class="btn btn-primary btn-lg btn-round" id="queryPHBtn">
                    查詢 <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div id="contentItem">
                @await Html.PartialAsync("QueryPopulationPartialView", Model)
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
         $('#queryPHBtn').on('click', function () {
             console.log('schoolSelect', $('#schoolSelect').val());
             console.log('queryYear', $('#queryYear').val());
             console.log('queryWeek', $('#queryWeek').val());
            $.ajax({
                   url: '@Url.Action("QueryPopulationPartial", "StudentPopulation")',
                   cache: false,
                   data: { 'schoolId': $('#schoolSelect').val(), 'week': $('#queryWeek').val(), 'year': $('#queryYear').val() },
                   // dataType: 'application/json',
                   type: 'POST',
                   dataType: "html",
                   success: function (data) {
                       $("#contentItem").html(data);
                   },
                   error: function () {
                   
                   }
            });
        });
    })

</script>
