@using PHStatistics.Content
@model StudentPopulation
@{
    List<SchoolAssignment> schools = new List<SchoolAssignment>();
    if (ViewBag.Schools != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }

    if (ViewBag.Weeks != null) {
        schools = (List<SchoolAssignment>)ViewBag.Schools;
    }
    string addType = ViewBag.Type;
}

<div class="container py-5">
    <div class="mt-3 mb-4">
        @if (schools != null) {
            <label for="">
                分校 <small class="text-primary">＊必填</small>
            </label>
            <select class="form-select validate[required]" id="schoolSelect">
                <option selected disabled>選擇分校</option>
                @foreach (SchoolAssignment assignment in schools) {
                    if (assignment.School == null) {
                        continue;
                    }
                    <option value=@assignment.School.Id>@assignment.School.Name</option>
                }
            </select>
            if (ViewBag.Years != null) {
                int[] years = (int[])ViewBag.Years;
                <label for="">
                    年度
                </label>
                <select class="form-select " id="queryYear">
                    <option selected disabled>選擇年度</option>
                    <option value=0>全部</option>
                    @foreach (int yearItem in years) {
                        <option value=@yearItem>@yearItem.ToString()</option>
                    }
                </select>
            }
            if (ViewBag.Weeks != null) {
                int[] weeks = (int[])ViewBag.Weeks;
                <label for="">
                    週次
                </label>
                <select class="form-select " id="queryWeek">
                    <option selected disabled>選擇週次</option>
                    <option value=0>全部</option>
                    @foreach (int weeekItem in weeks) {
                        <option value=@weeekItem>@weeekItem.ToString()</option>
                    }
                </select>
            }
            <label for="">
                類型 <small class="text-primary">＊必填</small>
            </label>
            <select class="form-select validate[required]" id="reportType">
                <option selected disabled>選擇類型</option>
                <option value="PH">百瀚</option>
                <option value="GEPG">英檢</option>
                <option value="PSJ">百倍速</option>
                <option value="PS">百世</option>
                <option value="AS">課輔班</option>
            </select>
        }
    </div>
    <div class="">
        <button type="button" class="btn btn-primary btn-lg btn-round" id="queryPHBtn">
            查詢 <i class="fas fa-paper-plane"></i>
        </button>
        <div class="dropdown d-inline-block">
            <button type="button" class="btn btn-success btn-lg btn-round dropdown-toggle" id="exportMenuBtn"
                    data-bs-toggle="dropdown" aria-expanded="false">
                匯出報表 <i class="fas fa-file-excel"></i>
            </button>
            <ul class="dropdown-menu" aria-labelledby="exportMenuBtn">
                <li><a class="dropdown-item" href="#" id="exportBtn">匯出本校報表</a></li>
                @if (ViewBag.CanExportAll == true) {
                    <li><a class="dropdown-item" href="#" id="exportAllBtn">匯出全區報表</a></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="#" id="exportDetailBtn" title="僅支援百瀚(PH)班級明細">
                        匯出 PH 班級明細（本校）
                    </a>
                </li>
                @if (ViewBag.CanExportAll == true) {
                    <li>
                        <a class="dropdown-item" href="#" id="exportAllDetailBtn" title="僅支援百瀚(PH)班級明細">
                            匯出 PH 班級明細（全區）
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div id="contentItem">
        @await Html.PartialAsync("QueryPopulationPartialView", Model)
    </div>
</div>
<script>

            $('#queryPHBtn').on('click', function () {
             console.log('schoolSelect', $('#schoolSelect').val());
             console.log('queryYear', $('#queryYear').val());
             console.log('queryWeek', $('#queryWeek').val());
              console.log('reportType', $('#reportType').val());
            $.ajax({
                   url: '@Url.Action("QueryPopulationPartial", "StudentPopulation", new { area = "" })',
                   cache: false,
                   data: { 'schoolId': $('#schoolSelect').val(), 'week': $('#queryWeek').val(), 'year': $('#queryYear').val(), 'reportType':  $('#reportType').val() },
                   // dataType: 'application/json',
                   type: 'POST',
                   dataType: "html",
                   success: function (data) {
                       $("#contentItem").html(data);
                   },
                   error: function () {

                   }
            });
        });

            // 匯出本校報表（依登入者分校過濾）
            $('#exportBtn').on('click', function () {
                var year = $('#queryYear').val();
                var week = $('#queryWeek').val();
                var type = $('#reportType').val();
                if (!year || !week || !type) { alert('請先選擇年度、週次及類型'); return; }
                var url = '@Url.Action("ExportReport", "StudentPopulation", new { area = "" })'
                    + '?year=' + year + '&week=' + week
                    + '&reportType=' + type + '&allSchools=false';
                window.location.href = url;
            });

            // 匯出全區報表（需 ViewAllSchools 權限，由後端再次驗證）
            $('#exportAllBtn').on('click', function () {
                var year = $('#queryYear').val();
                var week = $('#queryWeek').val();
                var type = $('#reportType').val();
                if (!year || !week || !type) { alert('請先選擇年度、週次及類型'); return; }
                var url = '@Url.Action("ExportReport", "StudentPopulation", new { area = "" })'
                    + '?year=' + year + '&week=' + week
                    + '&reportType=' + type + '&allSchools=true';
                window.location.href = url;
            });

            // PH 班級明細只支援百瀚(PH)類型，其他類型選擇時提醒使用者
            function confirmPHDetailType() {
                if ($('#reportType').val() !== 'PH') {
                    alert('「PH 班級明細」僅支援百瀚(PH)類型，請先將上方「類型」切換為百瀚後再匯出');
                    return false;
                }
                return true;
            }

            // 匯出本校 PH 明細
            $('#exportDetailBtn').on('click', function () {
                if (!confirmPHDetailType()) { return; }
                var year = $('#queryYear').val();
                var week = $('#queryWeek').val();
                if (!year || !week) { alert('請先選擇年度與週次'); return; }
                var url = '@Url.Action("ExportReportDetail", "StudentPopulation", new { area = "" })'
                    + '?year=' + year + '&week=' + week + '&allSchools=false';
                window.location.href = url;
            });

            // 匯出全區 PH 明細
            if ($('#exportAllDetailBtn').length) {
                $('#exportAllDetailBtn').on('click', function () {
                    if (!confirmPHDetailType()) { return; }
                    var year = $('#queryYear').val();
                    var week = $('#queryWeek').val();
                    if (!year || !week) { alert('請先選擇年度與週次'); return; }
                    var url = '@Url.Action("ExportReportDetail", "StudentPopulation", new { area = "" })'
                        + '?year=' + year + '&week=' + week + '&allSchools=true';
                    window.location.href = url;
                });
            }

