@{
    List<BannerPosition> positions = ViewBag.BannerPositions;
    bool canEdit = (bool)ViewBag.CanEdit;
}

<div class="container py-5">
    <div class="row justify-content-center mb-6">
        <div class="col-12 col-sm-10 col-md-8 col-xl-6 align-self-center">
            @if (ViewBag.ErrorMessage != null) {
                <div class="mt-3 mb-3 content">
                    <button type="button" class="btn btn-primary btn-lg btn-round">
                        @ViewBag.ErrorMessage
                    </button>
                </div>
            }
            <div class="mt-3 mb-4 ">
                @if (canEdit) {
                    <button type="button" class="btn btn-primary btn-lg btn-round" id="addNew">
                        輸入資料-百瀚
                    </button>
                    <button type="button" class="btn btn-primary btn-lg btn-round" id="addPSJNew">
                        輸入資料-百倍數
                    </button>
                    <button type="button" class="btn btn-primary btn-lg btn-round" id="addNewGept">
                        輸入資料-英檢班
                    </button>
                    <button type="button" class="btn btn-primary btn-lg btn-round" id="addNewPS">
                        輸入資料-百世
                    </button>
                }else{
                    <button type="button" class="btn btn-primary btn-lg btn-round" onclick="#" disabled="true">
                        輸入資料
                    </button>
                }
                <button type="button" class="btn btn-primary btn-lg btn-round" id="query">
                    查詢資料
                </button>
            </div>

        </div>
    </div>
</div>
<script>
    $('#addNew').on('click', function () {
        window.location.href = "/StudentPopulation/Index?type=PH";
    })
    $('#addPSJNew').on('click', function () {
        window.location.href = "/StudentPopulation/Index?type=PSJ";
    })
    $('#addNewGept').on('click', function () {
        window.location.href = "/StudentPopulation/Index?type=Gept";
    })
    $('#addNewPS').on('click', function () {
        window.location.href = "/StudentPopulation/Index?type=PS";
    })
</script>