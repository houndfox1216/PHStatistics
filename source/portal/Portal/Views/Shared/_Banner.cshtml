@model BannerPosition

@{
    var slideId = $"banner-position-{Model.Id}";
    var banners = Model.Banners.ToList();
}

<div id="@slideId" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
        @for (var i = 0; i < banners.Count; i++) {
            <button
                type="button"
                data-bs-target="#@slideId"
                data-bs-slide-to="@i"
                aria-label="@banners[i].Name"
                class="@(i == 0 ? "active" : string.Empty)"
                aria-current="@(i == 0 ? "true" : "false")"
            />
        }
    </div>
    <div class="carousel-inner">
        @for (var i = 0; i < banners.Count; i++) {
            <div class="carousel-item @(i == 0 ? "active" : string.Empty)">
                @if (banners[i].LinkUrl.HasValue()) {
                    <a href="@banners[i].LinkUrl">
                        <img src="@banners[i].Uri" class="d-block w-100" alt="@banners[i].Name">
                    </a>
                } else { 
                    <img src="@banners[i].Uri" class="d-block w-100" alt="@banners[i].Name">
                }
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#@slideId" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#@slideId" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
