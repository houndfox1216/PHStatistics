@{
    ViewBag.Title = "人數表管理";
}

<script>
    var schoolsStore = new DevExpress.data.CustomStore({
        key: "Id",
        loadMode: "raw",
        load: function () {
            return $.getJSON("@Url.Action("GetSchools", "StudentPopulation", new { area = "Admin" })")
                .then(function (r) { return r.data || r; });
        }
    });

    var populationTypes = [
        { id: 0, name: "百瀚 (PH)" },
        { id: 1, name: "百倍數 (PSJ)" },
        { id: 2, name: "英檢班 (GEPT)" },
        { id: 3, name: "百世 (PS)" },
        { id: 4, name: "安親課輔 (AfterSchool)" }
    ];

    var populationStatuses = [
        { id: 0, name: "已建檔" },
        { id: 1, name: "已送出" },
        { id: 2, name: "已審核" },
        { id: 3, name: "已否決" },
        { id: 4, name: "已完成" }
    ];

    $(function () {
        $("#schoolFilter").dxSelectBox({
            dataSource: schoolsStore,
            valueExpr: "Id",
            displayExpr: "Name",
            placeholder: "全部分校",
            showClearButton: true,
            width: 180,
            onValueChanged: function () { applyFilters(); }
        });

        $("#yearFilter").dxSelectBox({
            dataSource: {
                store: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function () {
                        return $.getJSON("@Url.Action("GetYears", "StudentPopulation", new { area = "Admin" })")
                            .then(function (r) { return r.data || r; });
                    }
                })
            },
            valueExpr: "Year",
            displayExpr: "Year",
            placeholder: "全部學年度",
            showClearButton: true,
            width: 130,
            onValueChanged: function (e) {
                var weekBox = $("#weekFilter").dxSelectBox("instance");
                weekBox.option("value", null);
                weekBox.option("disabled", e.value == null);
                if (e.value != null) {
                    weekBox.getDataSource().reload();
                }
                applyFilters();
            }
        });

        $("#weekFilter").dxSelectBox({
            dataSource: {
                store: new DevExpress.data.CustomStore({
                    loadMode: "raw",
                    load: function () {
                        var year = $("#yearFilter").dxSelectBox("instance").option("value");
                        if (!year) return [];
                        return $.getJSON("@Url.Action("GetWeeks", "StudentPopulation", new { area = "Admin" })", { year: year })
                            .then(function (r) { return r.data || r; });
                    }
                })
            },
            valueExpr: "Week",
            displayExpr: "Week",
            placeholder: "全部週次",
            showClearButton: true,
            disabled: true,
            width: 100,
            onValueChanged: function () { applyFilters(); }
        });
    });

    function applyFilters() {
        var schoolId = $("#schoolFilter").dxSelectBox("instance").option("value");
        var year = $("#yearFilter").dxSelectBox("instance").option("value");
        var week = $("#weekFilter").dxSelectBox("instance").option("value");

        var filters = [];
        if (schoolId != null) filters.push(["SchoolId", "=", schoolId]);
        if (year != null) {
            if (filters.length) filters.push("and");
            filters.push(["Year", "=", year]);
        }
        if (week != null) {
            if (filters.length) filters.push("and");
            filters.push(["Week", "=", week]);
        }

        $("#gridPopulations").dxDataGrid("instance").filter(filters.length > 0 ? filters : null);
    }

    function resetFilters() {
        $("#schoolFilter").dxSelectBox("instance").option("value", null);
        $("#yearFilter").dxSelectBox("instance").option("value", null);
        var weekBox = $("#weekFilter").dxSelectBox("instance");
        weekBox.option("value", null);
        weekBox.option("disabled", true);
        $("#gridPopulations").dxDataGrid("instance").filter(null);
    }

    function approveRow(e) {
        var id = e.row.data.Id;
        var grid = e.component;
        DevExpress.ui.dialog.confirm("確認將此筆人數表狀態改為「已審核」？", "確認操作")
            .then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: "@Url.Action("Approve", "StudentPopulation", new { area = "Admin" })",
                    type: "POST",
                    data: { key: id },
                    success: function () {
                        DevExpress.ui.notify("已審核", "success", 2000);
                        grid.refresh();
                    },
                    error: function (xhr) {
                        DevExpress.ui.notify("操作失敗：" + xhr.responseText, "error", 3000);
                    }
                });
            });
    }
</script>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0">分校</label>
                <div id="schoolFilter"></div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0">學年度</label>
                <div id="yearFilter"></div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="mb-0">週次</label>
                <div id="weekFilter"></div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">重設</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @(Html.DevExtreme().DataGrid<StudentPopulation>()
            .ID("gridPopulations")
            .DataSource(ds => ds.Mvc()
                .Controller("StudentPopulation")
                .Area("Admin")
                .LoadAction("GetStudentPopulations")
                .InsertAction("Create")
                .UpdateAction("Update")
                .DeleteAction("Delete")
                .Key("Id")
            )
            .RemoteOperations(true)
            .ShowBorders(true)
            .ShowRowLines(true)
            .AllowColumnResizing(true)
            .ColumnAutoWidth(true)
            .RowAlternationEnabled(true)
            .Paging(paging => paging.PageSize(20))
            .Pager(pager => pager
                .Visible(true)
                .ShowPageSizeSelector(true)
                .AllowedPageSizes(new[] { 10, 20, 50, 100 })
                .ShowInfo(true)
            )
            .Editing(editing => editing
                .Mode(GridEditMode.Popup)
                .AllowAdding(true)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                .Popup(popup => popup
                    .Title("人數表資料")
                    .ShowTitle(true)
                    .Width(700)
                    .Height("auto")
                )
            )
            .FilterRow(f => f.Visible(true))
            .SearchPanel(s => s.Visible(true).Width(240).Placeholder("搜尋..."))
            .HeaderFilter(h => h.Visible(true))
            .Columns(columns => {
                columns.AddFor(m => m.Id).Width(80).AllowEditing(false);
                columns.AddFor(m => m.SchoolId)
                    .Caption("分校")
                    .Lookup(lookup => lookup
                        .DataSource(new JS("schoolsStore"))
                        .ValueExpr("Id")
                        .DisplayExpr("Name")
                    );
                columns.AddFor(m => m.Year).Caption("學年度").Width(90);
                columns.AddFor(m => m.Week).Caption("週次").Width(70);
                columns.AddFor(m => m.Type)
                    .Caption("類型")
                    .Width(150)
                    .Lookup(lookup => lookup
                        .DataSource(new JS("populationTypes"))
                        .ValueExpr("id")
                        .DisplayExpr("name")
                    );
                columns.AddFor(m => m.Status)
                    .Caption("狀態")
                    .Width(100)
                    .Lookup(lookup => lookup
                        .DataSource(new JS("populationStatuses"))
                        .ValueExpr("id")
                        .DisplayExpr("name")
                    );
                columns.AddFor(m => m.Name).Caption("名稱");
                columns.AddFor(m => m.TotalInquiryCount).Caption("詢問人數").Width(90);
                columns.AddFor(m => m.SubmitterTime).Caption("送出時間").Width(150)
                    .DataType(GridColumnDataType.DateTime)
                    .Format("yyyy/MM/dd HH:mm")
                    .AllowEditing(false);
                columns.AddFor(m => m.CreatedTime).Caption("建立時間").Width(150)
                    .DataType(GridColumnDataType.DateTime)
                    .Format("yyyy/MM/dd HH:mm")
                    .AllowEditing(false);
                columns.Add()
                    .Type(GridCommandColumnType.Buttons)
                    .Width(110)
                    .Buttons(buttons => {
                        buttons.Add().Name("edit");
                        buttons.Add().Name("delete");
                        buttons.Add()
                            .Hint("審核通過")
                            .Icon("check")
                            .OnClick("approveRow")
                            .Visible("function(e) { return e.row.data.Status === 1; }");
                    });
            })
            .MasterDetail(md => md
                .Enabled(true)
                .Template(@<text>
                    <p class="mb-1 mt-2 fw-semibold">人數表項目</p>
                    @(Html.DevExtreme().DataGrid<StudentPopulationItem>()
                        .DataSource(ds => ds.Mvc()
                            .Controller("StudentPopulation")
                            .Area("Admin")
                            .LoadAction("GetItems")
                            .LoadParams(new { populationId = new JS("data.Id") })
                            .InsertAction("CreateItem")
                            .UpdateAction("UpdateItem")
                            .DeleteAction("DeleteItem")
                            .Key("Id")
                        )
                        .ShowBorders(true)
                        .ShowRowLines(true)
                        .ColumnAutoWidth(true)
                        .Paging(paging => paging.PageSize(50))
                        .Editing(editing => editing
                            .Mode(GridEditMode.Row)
                            .AllowAdding(true)
                            .AllowUpdating(true)
                            .AllowDeleting(true)
                            .UseIcons(true)
                        )
                        .Columns(columns => {
                            columns.AddFor(m => m.Id).Width(80).AllowEditing(false);
                            columns.AddFor(m => m.Name).Caption("名稱");
                            columns.AddFor(m => m.Number).Caption("人數").Width(80);
                            columns.AddFor(m => m.LastWeekNumber).Caption("上週人數").Width(90);
                            columns.AddFor(m => m.IsSum).Caption("加總").Width(70);
                            columns.AddFor(m => m.IsManual).Caption("手動").Width(70);
                            columns.AddFor(m => m.Remark).Caption("備註");
                        })
                        .Toolbar(toolbar => toolbar.Items(items => {
                            items.Add().Name("addRowButton");
                        }))
                        .OnInitNewRow("function(e) { e.data.StudentPopulationId = data.Id; }")
                    )
                </text>)
            )
            .Toolbar(toolbar => toolbar.Items(items => {
                items.Add().Name("addRowButton");
                items.Add().Name("searchPanel");
            }))
        )
    </div>
</div>
