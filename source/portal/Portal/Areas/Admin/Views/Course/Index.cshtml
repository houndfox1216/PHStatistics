@{
    ViewBag.Title = "課程管理";
}

<script>
    var courseDepartmentsStore = new DevExpress.data.CustomStore({
        key: "Id",
        loadMode: "raw",
        load: function () {
            return $.getJSON("@Url.Action("GetDepartments", "Course", new { area = "Admin" })")
                .then(function (r) { return r.data || r; });
        }
    });

    var courseOptionsStore = new DevExpress.data.CustomStore({
        key: "Id",
        loadMode: "raw",
        load: function () {
            return $.getJSON("@Url.Action("GetCourseOptions", "Course", new { area = "Admin" })")
                .then(function (r) { return r.data || r; });
        }
    });

    function onCourseEditorPreparing(e) {
        if (e.parentType !== "dataRow") return;

        if (e.dataField === "SourceDepartmentIdValues") {
            var currentDepartmentValue = e.value ? e.value.slice() : [];
            e.editorName = "dxTagBox";
            e.editorOptions = {
                dataSource: courseDepartmentsStore,
                valueExpr: "Id",
                displayExpr: "Name",
                value: currentDepartmentValue,
                showSelectionControls: true,
                searchEnabled: true,
                multiline: true,
                onValueChanged: function (args) {
                    e.setValue(args.value);
                }
            };
        }

        if (e.dataField === "SourceCourseIdValues") {
            var currentCourseValue = e.value ? e.value.slice() : [];
            e.editorName = "dxTagBox";
            e.editorOptions = {
                dataSource: courseOptionsStore,
                valueExpr: "Id",
                displayExpr: "Name",
                value: currentCourseValue,
                showSelectionControls: true,
                searchEnabled: true,
                multiline: true,
                onValueChanged: function (args) {
                    e.setValue(args.value);
                }
            };
        }
    }

    function renderIdTagsCell(container, values, store) {
        if (!values || values.length === 0) {
            $("<span>").text("（無）").css("color", "#999").appendTo(container);
            return;
        }
        var $wrap = $("<div>").css({ display: "flex", flexWrap: "wrap", gap: "4px", padding: "2px 0" });
        values.forEach(function (v) {
            store.byKey(v).then(function (item) {
                $("<span>")
                    .text(item ? item.Name : v)
                    .css({
                        display: "inline-block",
                        padding: "1px 8px",
                        borderRadius: "12px",
                        background: "#e9ecef",
                        fontSize: "12px"
                    })
                    .appendTo($wrap);
            });
        });
        $wrap.appendTo(container);
    }

    function departmentIdsCellTemplate(container, options) {
        renderIdTagsCell(container, options.value, courseDepartmentsStore);
    }

    function courseIdsCellTemplate(container, options) {
        renderIdTagsCell(container, options.value, courseOptionsStore);
    }
</script>

<div class="card">
    <div class="card-body">
        @(Html.DevExtreme().DataGrid<Course>()
            .ID("gridCourses")
            .DataSource(ds => ds.Mvc()
                .Controller("Course")
                .Area("Admin")
                .LoadAction("GetCourses")
                .InsertAction("Create")
                .UpdateAction("Update")
                .DeleteAction("Delete")
                .Key("Id")
            )
            .RemoteOperations(true)
            .ShowBorders(true)
            .ShowRowLines(true)
            .AllowColumnResizing(true)
            .ColumnAutoWidth(true)
            .RowAlternationEnabled(true)
            .Paging(paging => paging.PageSize(20))
            .Pager(pager => pager
                .Visible(true)
                .ShowPageSizeSelector(true)
                .AllowedPageSizes(new[] { 10, 20, 50, 100 })
                .ShowInfo(true)
            )
            .Editing(editing => editing
                .Mode(GridEditMode.Popup)
                .AllowAdding(true)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .UseIcons(true)
                .Popup(popup => popup
                    .Title("課程資料")
                    .ShowTitle(true)
                    .Width(600)
                    .Height("auto")
                )
                .Form(form => form
                    .ColCount(1)
                    .Items(items => {
                        items.AddSimple().DataField("Id").Label(l => l.Text("識別碼"));
                        items.AddSimple().DataField("Name").Label(l => l.Text("名稱"));
                        items.AddSimple().DataField("DepartmentId").Label(l => l.Text("班系"));
                        items.AddSimple().DataField("ClassType").Label(l => l.Text("適用班別"));
                        items.AddSimple().DataField("Ordinal").Label(l => l.Text("排列順序"));
                        items.AddSimple().DataField("IsSum").Label(l => l.Text("加總"));
                        items.AddSimple().DataField("Published").Label(l => l.Text("已發佈"));
                        items.AddSimple().DataField("Type").Label(l => l.Text("所屬單位"));
                        items.AddSimple().DataField("StatisticsType").Label(l => l.Text("加總類型"));
                        items.AddSimple().DataField("SourceDepartmentIdValues").Label(l => l.Text("來源班系"));
                        items.AddSimple().DataField("SourceCourseIdValues").Label(l => l.Text("來源課程"));
                        items.AddSimple().DataField("ApplicableClassType").Label(l => l.Text("適用班別"));
                        items.AddSimple().DataField("GroupByClassType").Label(l => l.Text("依班別分組"));
                    })
                )
            )
            .FilterRow(f => f.Visible(true))
            .SearchPanel(s => s.Visible(true).Width(240).Placeholder("搜尋..."))
            .HeaderFilter(h => h.Visible(true))
            .OnEditorPreparing("onCourseEditorPreparing")
            .Columns(columns => {
                columns.AddFor(m => m.Id).Width(80).AllowEditing(false);
                columns.AddFor(m => m.Name).Caption("名稱");
                columns.AddFor(m => m.DepartmentId)
                    .Caption("班系")
                    .Lookup(lookup => lookup
                        .DataSource(ds => ds.Mvc()
                            .Controller("Course")
                            .Area("Admin")
                            .LoadAction("GetDepartments")
                            .Key("Id")
                        )
                        .ValueExpr("Id")
                        .DisplayExpr("Name")
                    );
                columns.AddFor(m => m.ClassType).Caption("適用班別");
                columns.AddFor(m => m.Ordinal).Caption("排列順序").Width(100);
                columns.AddFor(m => m.IsSum).Caption("加總").Width(80);
                columns.AddFor(m => m.Published).Caption("已發佈").Width(80);
                columns.AddFor(m => m.Type).Caption("所屬單位").Width(100);
                columns.AddFor(m => m.StatisticsType)
                    .Caption("加總類型")
                    .Lookup(lookup => lookup
                        .DataSource(new[] {
                            new { Id = 0,  Name = "使用者輸入" },
                            new { Id = 1,  Name = "同班系人數加總" },
                            new { Id = 2,  Name = "同班系+同班別人數加總" },
                            new { Id = 3,  Name = "指定來源班系人數加總" },
                            new { Id = 4,  Name = "指定來源課程人數加總" },
                            new { Id = 10, Name = "與上週相比" },
                            new { Id = 11, Name = "去年同期比較" },
                            new { Id = 30, Name = "班級數量統計" },
                            new { Id = 31, Name = "班級數量統計依班別" },
                            new { Id = 40, Name = "上週數值" },
                            new { Id = 41, Name = "去年同期數值" },
                            new { Id = 50, Name = "手動輸入" },
                        })
                        .ValueExpr("Id")
                        .DisplayExpr("Name")
                    );
                columns.Add()
                    .DataField("SourceDepartmentIdValues")
                    .Caption("來源班系")
                    .AllowSorting(false)
                    .AllowFiltering(false)
                    .CellTemplate("departmentIdsCellTemplate")
                    .Width(220);
                columns.Add()
                    .DataField("SourceCourseIdValues")
                    .Caption("來源課程")
                    .AllowSorting(false)
                    .AllowFiltering(false)
                    .CellTemplate("courseIdsCellTemplate")
                    .Width(220);
                columns.AddFor(m => m.ApplicableClassType)
                    .Caption("適用班別")
                    .Lookup(lookup => lookup
                        .DataSource(new[] {
                            new { Id = 0, Name = "團" },
                            new { Id = 1, Name = "EM1" },
                            new { Id = 2, Name = "EM2" },
                            new { Id = 3, Name = "三" },
                            new { Id = 4, Name = "小" },
                            new { Id = 5, Name = "一般" },
                        })
                        .ValueExpr("Id")
                        .DisplayExpr("Name")
                    );
                columns.AddFor(m => m.GroupByClassType).Caption("依班別分組").Width(90);
            })
            .Toolbar(toolbar => toolbar.Items(items => {
                items.Add().Name("addRowButton");
                items.Add().Name("searchPanel");
            }))
        )
    </div>
</div>
